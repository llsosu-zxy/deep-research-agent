# LLM provider: mock (offline demo) or openai_compatible (DeepSeek/Qwen/Ollama)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# Retrieval: hash | sentence-transformers | bge-m3
EMBEDDING_MODE=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANKER=identity
RERANKER_MODEL=BAAI/bge-reranker-base

# Agent limits
MAX_TOOL_STEPS=12
MAX_CRITIC_ITERATIONS=2
DAILY_BUDGET_USD=0.50
RETRIEVAL_TOP_K=5

# App
API_HOST=127.0.0.1
API_PORT=8000
